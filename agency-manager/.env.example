# =============================================================================
# KIRA Agency Manager — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.
# =============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Session Secret (server-side ONLY) ────────────────────────────────────────
SESSION_SECRET=

# ─── Firebase Client SDK (public — safe for browser bundle) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-side ONLY — NEVER expose to browser) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Include literal \n for newlines in the private key string
FIREBASE_PRIVATE_KEY=

# ─── Google Cloud Storage (server-side ONLY) ──────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
# Path to service account JSON key file (local dev only)
# Production: use Workload Identity Federation instead of JSON key files
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_PRIVATE_KEY=

# ─── Google Drive (optional, server-side ONLY) ────────────────────────────────
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# ─── Platform Integrations (server-side ONLY — add when implementing adapters) ─
# Instagram Graph API
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=
# INSTAGRAM_REDIRECT_URI=

# TikTok for Developers
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=

# X (Twitter) API v2
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=

# YouTube Data API v3
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=

# ─── Diagnostics (rotate or remove in production) ─────────────────────────────
# DIAGNOSTIC_API_KEY=
