# =============================================================================
# KIRA Frontend — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
#
# ⚠️  Only PUBLIC Firebase client config values go here.
# ⚠️  NEVER put GCS credentials, private keys, or service-account JSON here.
# =============================================================================

# Backend API URL (your Express server)
VITE_API_BASE_URL=http://localhost:4000

# ─── Firebase Web App Config ───────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web → Config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
